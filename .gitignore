# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/

# Editors/IDEs
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Home Assistant (falls Repo mal versehentlich neben einer echten HA-Config liegt)
.storage/
*.log

# Test- und Linter-Caches
.pytest_cache/
.ruff_cache/

# Coverage output. The database stores absolute source paths, so it carries the
# developer's home directory into the repository - and being binary, it slips
# past a leak scan that reads the diff as text.
.coverage
.coverage.*
htmlcov/
